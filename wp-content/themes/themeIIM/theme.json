{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "spacing": {
      "spacingSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "0.5rem"
        },
        {
          "slug": "medium",
          "name": "Moyen",
          "size": "1.5rem"
        },
        {
          "slug": "large",
          "name": "Grand",
          "size": "4rem"
        }
      ]
    },
    "typography": {
      "fontSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "0.9rem"
        },
        {
          "slug": "medium",
          "name": "Moyen",
          "size": "1.125rem"
        },
        {
          "slug": "large",
          "name": "Grand",
          "size": "2rem"
        }
      ],
      "fontFamilies": [
        {
          "slug": "poppins",
          "name": "Poppins",
          "fontFamily": "\"Poppins\",cursive",
          "fontFace": [
            {
              "fontFamily": "Poppins",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/Poppins-Regular.woff", "file:./assets/fonts/Poppins-Regular.woff2"]
            },
            {
              "fontFamily": "Poppins",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/Poppins-Bold.woff", "file:./assets/fonts/Poppins-Bold.woff2"]
            }
          ]
        },
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "\"Inter\",cursive",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/Inter18pt-Regular.woff", "file:./assets/fonts/Inter18pt-Regular.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/Inter18pt-Bold.woff", "file:./assets/fonts/Inter18pt-Bold.woff2"]
            }
          ]
        }
      ]
    },
    "layout": {
      "contentSize": "700px",
      "wideSize": "1100px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--light)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6",
      "fontFamily": "var(--wp--preset--font-family--inter)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "En-tête",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pied de page",
      "area": "footer"
    }
  ]
}